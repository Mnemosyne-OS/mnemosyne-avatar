  "lines": [
    {
      "id": "almost-dead",
      "at": 0.35,
      "end": 2.314,
      "text": "Hi. I'm almost human.",
      "shape": "woman"
    },
    {
      "id": "almost-alive",
      "at": 2.964,
      "end": 4.928,
      "text": "Hi. I'm almost human.",
      "shape": "woman"
    },
    {
      "id": "better",
      "at": 5.178,
      "end": 5.627,
      "text": "Better?",
      "shape": "woman"
    },
    {
      "id": "valley",
      "at": 5.977,
      "end": 10.136,
      "text": "That shiver, a second ago? It has a name. The uncanny valley.",
      "shape": "woman"
    },
    {
      "id": "skin",
      "at": 11.15,
      "end": 16.47,
      "text": "A face isn't skin. It's the blink. The glance. The half second before a smile.",
      "shape": "voiceover"
    },
    {
      "id": "robot",
      "at": 18.1,
      "end": 19.551,
      "text": "Even a robot can cross it.",
      "shape": "voiceover"
    },
    {
      "id": "helmet",
      "at": 20.55,
      "end": 23.804,
      "text": "I am... your assistant.",
      "shape": "robot-boulon"
    },
    {
      "id": "mask",
      "at": 24.704,
      "end": 29.719,
      "text": "I'm not a mask. I'm a conversation. I live on your machine, and I remember with you.",
      "shape": "woman"
    },
    {
      "id": "yours",
      "at": 30.119,
      "end": 30.996,
      "text": "Make yours.",
      "shape": "woman"
    }
  ],
